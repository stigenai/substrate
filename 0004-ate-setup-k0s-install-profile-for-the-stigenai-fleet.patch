+# stigenai k0s profile: the fleet already runs an OTLP collector
+# (monitoring/otel-collector, fan-out to Tempo/Prometheus/Loki), so control
+# plane telemetry goes there instead of to a bundled collector. Same name as
+# ../ate-otel-config.yaml, so every component's envFrom resolves to it.
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: ate-otel-config
+  namespace: ate-system
+data:
+  OTEL_EXPORTER_OTLP_ENDPOINT: http://otel-collector.monitoring.svc:4317
+  OTEL_METRIC_EXPORT_INTERVAL: "10000"
+  OTEL_METRIC_EXPORT_TIMEOUT: "10000"
+  OTEL_LOGS_EXPORTER: otlp
+  ATE_WORKER_OTEL_LOGS_EXPORTER: otlp
diff --git a/manifests/ate-install/k0s/atelet/kustomization.yaml b/manifests/ate-install/k0s/atelet/kustomization.yaml
new file mode 100644
index 000000000..04d34fe9b
--- /dev/null
+++ b/manifests/ate-install/k0s/atelet/kustomization.yaml
@@ -0,0 +1,99 @@
+# Copyright 2026 The Agent Substrate Authors
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
