+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+apiVersion: kustomize.config.k8s.io/v1beta1
+kind: Kustomization
+
+# Plain ../../atelet.yaml, unlike ../../kind/atelet: k0s keeps the kubelet under
+# /var/lib/k0s/kubelet, so CSI plugin sockets live there (the container-side
+# mount path is unchanged). Device plugins do not move: kubelet's
+# DevicePluginPath is a constant, /var/lib/kubelet/device-plugins.
+#
+# There is no kubelet image credential provider on the node, so its flags and
+# host mounts go. The mounted ate-registry-auth Secret authenticates private
+# registries instead; atelet reads $DOCKER_CONFIG/config.json when it has no
+# credential provider. Optional, so a cluster without the Secret still pulls
+# public images anonymously.
+resources:
+  - ../../atelet.yaml
+
+patches:
+  - patch: |-
+      apiVersion: apps/v1
+      kind: DaemonSet
+      metadata:
+        name: atelet
+        namespace: ate-system
+      spec:
+        template:
+          spec:
+            initContainers:
+            - name: objectstore-plugin
+              env:
+              - name: ATE_STORAGE_BACKEND
+                value: s3
+              - name: AWS_REGION
+                value: us-east-1
+              - name: AWS_ENDPOINT_URL
+                value: http://rustfs.ate-system.svc:9000
+              - name: AWS_S3_USE_PATH_STYLE
+                value: "true"
+              - name: AWS_ACCESS_KEY_ID
+                valueFrom:
+                  secretKeyRef: {name: ate-s3-credentials, key: AWS_ACCESS_KEY_ID}
+              - name: AWS_SECRET_ACCESS_KEY
+                valueFrom:
+                  secretKeyRef: {name: ate-s3-credentials, key: AWS_SECRET_ACCESS_KEY}
+            containers:
+            - name: atelet
+              env:
+              - name: DOCKER_CONFIG
+                value: /run/registry-auth
+              volumeMounts:
+              - name: registry-auth
+                mountPath: /run/registry-auth
+                readOnly: true
+              - mountPath: /run/image-credential-provider/bin
+                $patch: delete
+              - mountPath: /run/image-credential-provider/config.yaml
+                $patch: delete
+            volumes:
+            - name: registry-auth
+              secret:
+                secretName: ate-registry-auth
+                optional: true
+                items:
+                - key: .dockerconfigjson
+                  path: config.json
+            - name: image-credential-provider-bin
+              $patch: delete
+            - name: image-credential-provider-config
+              $patch: delete
+            - name: kubelet-plugins
+              hostPath:
+                path: /var/lib/k0s/kubelet/plugins
+  - target:
+      kind: DaemonSet
+      name: atelet
+    patch: |-
+      - op: test
+        path: /spec/template/spec/containers/0/args/0
+        value: --image-credential-provider-config=/run/image-credential-provider/config.yaml
+      - op: remove
+        path: /spec/template/spec/containers/0/args/0
+      - op: test
+        path: /spec/template/spec/containers/0/args/0
+        value: --image-credential-provider-bin-dir=/run/image-credential-provider/bin
+      - op: remove
+        path: /spec/template/spec/containers/0/args/0
