From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zach Taylor <zctaylor.work@gmail.com>
Date: Thu, 26 Nov 2026 17:17:01 -0500
Subject: [PATCH 05/30] egress: prefer IPv4 in the DNS cache; gtr has no IPv6
 egress

With ALL the gateway dialed api.anthropic.com's AAAA answer and failed
upstream TLS. V4_PREFERRED still falls back to AAAA for v6-only names.

Fork-Topic: k0s
Fork-Upstream: fork-only
---
 cmd/ate-setup/internal/steps/egress_dns_test.go | 6 +++---
 manifests/ate-install/atenet-egress.yaml        | 9 +++++----
 2 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/cmd/ate-setup/internal/steps/egress_dns_test.go b/cmd/ate-setup/internal/steps/egress_dns_test.go
index 7b18edc8c..fde79957e 100644
--- a/cmd/ate-setup/internal/steps/egress_dns_test.go
+++ b/cmd/ate-setup/internal/steps/egress_dns_test.go
@@ -34,7 +34,7 @@ import (
 	"go.ate.dev/substrate/cmd/ate-setup/internal/kustomize"
 )
 
-// TestEgressDNSCacheSettings requires ALL and the resolved address filter on
+// TestEgressDNSCacheSettings requires V4_PREFERRED and the resolved address filter on
 // every dynamic forward proxy DNS cache in the install tree, so a new egress
 // manifest is checked the day it is added rather than the day it is installed.
 // atenet-egress.yaml says why.
@@ -108,8 +108,8 @@ func requireDNSCacheSettings(t *testing.T, caches []map[string]any) {
 	// A sample of the denied ranges: loopback and link-local in both families.
 	mustDeny := []string{"127.0.0.0/8", "169.254.0.0/16", "::1/128", "fe80::/10"}
 	for _, cache := range caches {
-		if got := cache["dns_lookup_family"]; got != "ALL" {
-			t.Errorf("dns_cache_config %v: dns_lookup_family = %v, want ALL", cache["name"], got)
+		if got := cache["dns_lookup_family"]; got != "V4_PREFERRED" {
+			t.Errorf("dns_cache_config %v: dns_lookup_family = %v, want V4_PREFERRED", cache["name"], got)
 		}
 		var denied []string
 		filter, _ := cache["resolved_address_filter"].(map[string]any)
diff --git a/manifests/ate-install/atenet-egress.yaml b/manifests/ate-install/atenet-egress.yaml
index bdb1d4ddf..a92e3f1ff 100644
--- a/manifests/ate-install/atenet-egress.yaml
+++ b/manifests/ate-install/atenet-egress.yaml
@@ -594,10 +594,11 @@ data:
                   # configs under one cache name.
                   dns_cache_config: &egress_dns_cache
                     name: egress_dns_cache
-                    # V4_ONLY resolves nothing on an IPv6-only cluster. ALL
-                    # returns both families and enables Happy Eyeballs, so
-                    # neither family is stranded.
-                    dns_lookup_family: ALL
+                    # stigenai: V4_PREFERRED, not upstream's ALL. The gtr cluster
+                    # has no IPv6 egress, and ALL dialed AAAA answers it cannot
+                    # reach. V4_PREFERRED still falls back to AAAA for a
+                    # v6-only name, so no name is stranded (V4_ONLY would be).
+                    dns_lookup_family: V4_PREFERRED
                     # The gateway never dials these, even for a "*" rule or a
                     # name that resolves to them: loopback (this pod's admin
                     # and ext_proc ports), link-local, unspecified, and the
-- 
