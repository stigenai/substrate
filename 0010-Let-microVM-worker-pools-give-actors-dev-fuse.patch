diff --git a/internal/e2e/suites/guestdevices/guestdevices_test.go b/internal/e2e/suites/guestdevices/guestdevices_test.go
new file mode 100644
index 000000000..b3bae8456
--- /dev/null
+++ b/internal/e2e/suites/guestdevices/guestdevices_test.go
@@ -0,0 +1,141 @@
+// Copyright 2026 The Agent Substrate Authors
