+# The k8s half of the guestdevices fixture: two microVM pools that differ only
+# in the sandbox class's guestDevices. The suite deploys it only in the microVM
+# lane, because the API server refuses guestDevices on a gvisor class.
+
+apiVersion: v1
+kind: Namespace
+metadata:
+  name: ate-e2e${FIXTURE_SUFFIX}
+
+---
+
+apiVersion: ate.dev/v1
+kind: WorkerPool
+metadata:
+  name: fuse
+  namespace: ate-e2e${FIXTURE_SUFFIX}
+  labels:
+    workload: guestdevices-fuse
+spec:
