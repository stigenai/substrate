+# The LayerFS test's ActorTemplates: protojson-shaped ateapi.ActorTemplate
+# documents. Both run run.py in the LayerFS spike image with SYS_ADMIN, which
+# the mount needs, and SETUID and SETGID, which ax_probe needs to run its
+# command in the mount as uid 1001. They differ only in the pool they select
+# from the guestdevices pool manifest.
+# The test fills the LAYERFS_IMAGE placeholder (pinned by digest) and the
+# LAYERFS_COMMAND placeholder (a JSON list that runs run.py).
+
+metadata:
+  atespace: ate-e2e${FIXTURE_SUFFIX}
+  name: layerfs-fuse
+workerSelector:
+  matchLabels:
+    workload: guestdevices-fuse
+containers:
+- name: layerfs
+  image: ${LAYERFS_IMAGE}
+  command: ${LAYERFS_COMMAND}
+  securityContext:
+    capabilities:
+      add: ["SYS_ADMIN", "SETUID", "SETGID"]
+  wakeupProbe:
+    httpGet:
+      path: /healthz
+      port: 80
+    timeoutSeconds: 60
+resources:
+  limits:
+    cpuMillicores: 1000
+    memoryBytes: 536870912 # 512Mi
+
+---
+
+metadata:
+  atespace: ate-e2e${FIXTURE_SUFFIX}
+  name: layerfs-nofuse
+workerSelector:
+  matchLabels:
+    workload: guestdevices-nofuse
+containers:
+- name: layerfs
+  image: ${LAYERFS_IMAGE}
+  command: ${LAYERFS_COMMAND}
+  securityContext:
+    capabilities:
+      add: ["SYS_ADMIN", "SETUID", "SETGID"]
+  wakeupProbe:
+    httpGet:
+      path: /healthz
+      port: 80
+    timeoutSeconds: 60
+resources:
+  limits:
+    cpuMillicores: 1000
+    memoryBytes: 536870912 # 512Mi
