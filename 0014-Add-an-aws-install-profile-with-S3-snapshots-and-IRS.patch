+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+# Copy the gVisor release tarballs that manifests/ate-install/sandboxconfig-gvisor.yaml
+# names (each release, amd64 and arm64) from the public gvisor bucket to an S3
+# location. Check each sha256 before the upload.
+# Usage: GVISOR_MIRROR_S3_URI=s3://BUCKET/PREFIX hack/aws/mirror-runsc.sh
+# Use AWS_PROFILE or the default AWS provider chain for the upload.
+# The upload paths match manifests/ate-install/aws/sandboxconfig-gvisor.yaml.
+
+set -o errexit -o nounset -o pipefail
+
+: "${GVISOR_MIRROR_S3_URI:?Set GVISOR_MIRROR_S3_URI to s3://BUCKET/PREFIX}"
+
+ROOT="$(git rev-parse --show-toplevel)"
+SRC_URL_PREFIX="gs://gvisor/releases/release/"
+DEST="${GVISOR_MIRROR_S3_URI%/}"
+
+work="$(mktemp -d)"
+trap 'rm -rf "${work}"' EXIT
+
+# Each "url:" line is followed by its "sha256:" line.
+awk '/url: "gs:\/\//{gsub(/"/,"",$2); url=$2} /sha256:/{gsub(/"/,"",$2); print url, $2}' \
+  "${ROOT}/manifests/ate-install/sandboxconfig-gvisor.yaml" |
+  while read -r url sum; do
+    path="${url#"${SRC_URL_PREFIX}"}" # RELEASE/ARCH/gvisor.tar.zstd
+    file="${work}/$(echo "${path}" | tr / _)"
+    curl --fail --silent --show-error --location \
+      "https://storage.googleapis.com/gvisor/releases/release/${path}" --output "${file}"
+    echo "${sum}  ${file}" | shasum -a 256 --check --status
+    aws s3 cp "${file}" "${DEST}/${path}"
+  done
diff --git a/hack/aws/validate.sh b/hack/aws/validate.sh
new file mode 100755
index 000000000..5a5956e68
--- /dev/null
+++ b/hack/aws/validate.sh
@@ -0,0 +1,60 @@
+#!/usr/bin/env bash
+
+# Copyright 2026 The Agent Substrate Authors
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+# Render the aws profile and its SandboxConfig, and check them with kubeconform
+# against the Kubernetes schemas and the Substrate CRDs.
+# Fail if a gs:// URL or a GKE path remains in the output.
+# Needs kustomize, kubeconform and python3 with PyYAML.
+
+set -o errexit -o nounset -o pipefail
+
+ROOT="$(git rev-parse --show-toplevel)"
+cd "${ROOT}"
+
+work="$(mktemp -d)"
+trap 'rm -rf "${work}"' EXIT
+
+# One JSON schema per CRD version, named <Kind>_<version>.json.
+python3 -I - "${ROOT}/manifests/ate-install/generated" "${work}" <<'EOF'
+import json, pathlib, sys, yaml
+
+src, dst = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
+for f in src.glob("ate.dev_*.yaml"):
+    for doc in yaml.safe_load_all(f.read_text()):
+        if not doc or doc.get("kind") != "CustomResourceDefinition":
+            continue
+        kind = doc["spec"]["names"]["kind"]
+        for v in doc["spec"]["versions"]:
+            (dst / f"{kind}_{v['name']}.json").write_text(
+                json.dumps(v["schema"]["openAPIV3Schema"]))
+EOF
+
+{
+  kustomize build --load-restrictor LoadRestrictionsNone manifests/ate-install/aws
+  echo ---
+  cat manifests/ate-install/aws/sandboxconfig-gvisor.yaml
+} >"${work}/rendered.yaml"
+
+if grep -nE 'gs://|/home/kubernetes' "${work}/rendered.yaml"; then
+  echo "FAIL: the rendered output has a GKE reference" >&2
+  exit 1
+fi
+
+# The ko:// image references are resolved by ate-setup at install.
+kubeconform -strict -summary \
+  -schema-location default \
+  -schema-location "${work}/{{ .ResourceKind }}_{{ .ResourceAPIVersion }}.json" \
+  "${work}/rendered.yaml"
