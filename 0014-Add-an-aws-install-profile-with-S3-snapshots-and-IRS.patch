+
+apiVersion: kustomize.config.k8s.io/v1beta1
+kind: Kustomization
+
+# ate-api-server's object-store plugin writes and deletes snapshots in S3 with
+# the IRSA role of its service account.
+resources:
+  - ../../ate-api-server.yaml
+
+patches:
+  - patch: |-
+      apiVersion: v1
+      kind: ServiceAccount
+      metadata:
+        name: ate-api-server
+        namespace: ate-system
+        annotations:
+          # EDIT
+          eks.amazonaws.com/role-arn: arn:aws:iam::123456789012:role/ate-api-server
+  - patch: |-
+      apiVersion: apps/v1
+      kind: Deployment
+      metadata:
+        name: ate-api-server
+        namespace: ate-system
+      spec:
+        template:
+          spec:
+            initContainers:
+            - name: objectstore-plugin
+              env:
+              - name: ATE_STORAGE_BACKEND
+                value: s3
+              - name: AWS_REGION
+                # EDIT
+                value: us-east-1
