+			for _, p := range []string{"/anything", "/a", "/", "/a/../b"} {
+				if got := compiled.EvaluateRequest(atPath("github.com", p), true); got.Allowed {
+					t.Errorf("EvaluateRequest(%q) = %+v, want a deny: the rule must not widen to all paths", p, got)
