+package supervisorbootstrap_test
+
+import (
+	"testing"
+
+	"go.ate.dev/substrate/api/ateapi/v1"
+	"go.ate.dev/substrate/internal/supervisorbootstrap"
+	"go.ate.dev/substrate/internal/supervisorbootstrap/supervisorbootstraptest"
+)
+
+func TestDescribe(t *testing.T) {
+	template := supervisorbootstraptest.Template()
+	got, err := supervisorbootstrap.Describe(template)
+	if err != nil || got == nil {
+		t.Fatalf("Describe: %v", err)
+	}
+	template.Metadata.Version = 42
+	again, err := supervisorbootstrap.Describe(template)
+	if err != nil || again.TemplateDigest != got.TemplateDigest {
+		t.Fatal("metadata changed template digest")
+	}
+	template.Containers[0].Env[0].Value = "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
+	changed, err := supervisorbootstrap.Describe(template)
+	if err != nil || changed.TemplateDigest == got.TemplateDigest {
+		t.Fatal("launch binding not hashed")
+	}
+	if ordinary, err := supervisorbootstrap.Describe(&ateapi.ActorTemplate{}); ordinary != nil || err != nil {
+		t.Fatal("ordinary template affected")
+	}
+}
+
+func TestDescribeDenials(t *testing.T) {
+	for name, mutate := range map[string]func(*ateapi.ActorTemplate){
+		"profile": func(v *ateapi.ActorTemplate) {
+			v.Volumes[0].GetSystemInfo().DataSources[0].GetSupervisorBootstrap().Profile = "other"
+		},
+		"memory": func(v *ateapi.ActorTemplate) {
+			v.SnapshotConfig.PreferredFidelity = ateapi.SnapshotFidelity_SNAPSHOT_FIDELITY_MEMORY
+		},
+		"unset fidelity": func(v *ateapi.ActorTemplate) { v.SnapshotConfig = nil },
+		"image":          func(v *ateapi.ActorTemplate) { v.Containers[0].Image = "worker:latest" },
+		"command":        func(v *ateapi.ActorTemplate) { v.Containers[0].Command = []string{"sh"} },
+		"mount":          func(v *ateapi.ActorTemplate) { v.Containers[0].VolumeMounts[0].MountPath = "/tmp" },
+		"launch":         func(v *ateapi.ActorTemplate) { v.Containers[0].Env = nil },
+		"sidecar":        func(v *ateapi.ActorTemplate) { v.Containers = append(v.Containers, v.Containers[0]) },
+		"mixed": func(v *ateapi.ActorTemplate) {
+			v.Volumes[0].GetSystemInfo().DataSources = append(v.Volumes[0].GetSystemInfo().DataSources, &ateapi.SystemInfoDataSource{})
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			v := supervisorbootstraptest.Template()
+			mutate(v)
+			if _, err := supervisorbootstrap.Describe(v); err == nil {
+				t.Fatal("accepted unsafe template")
+			}
+		})
+	}
+}
