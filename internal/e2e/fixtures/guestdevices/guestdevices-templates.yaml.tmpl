# The guestdevices fixture's ActorTemplates: protojson-shaped
# ateapipb.ActorTemplate documents. Both run the probe with SYS_ADMIN, which a
# FUSE mount needs. They differ only in the pool they select, so the result
# depends only on the pool's guestDevices.

metadata:
  atespace: ate-e2e${FIXTURE_SUFFIX}
  name: fuse
workerSelector:
  matchLabels:
    workload: guestdevices-fuse
containers:
- name: probe
  image: ko://github.com/agent-substrate/substrate/internal/e2e/fixtures/probe
  command: ["/ko-app/probe"]
  securityContext:
    capabilities:
      add: ["SYS_ADMIN"]
  wakeupProbe:
    httpGet:
      path: /healthz
      port: 80
    timeoutSeconds: 60
${TEMPLATE_RESOURCES}
${TEMPLATE_SANDBOX_CONFIG}
snapshotConfig:
  storageLocation: gs://${BUCKET_NAME}/ate-e2e-guestdevices-fuse${FIXTURE_SUFFIX}/

---

metadata:
  atespace: ate-e2e${FIXTURE_SUFFIX}
  name: nofuse
workerSelector:
  matchLabels:
    workload: guestdevices-nofuse
containers:
- name: probe
  image: ko://github.com/agent-substrate/substrate/internal/e2e/fixtures/probe
  command: ["/ko-app/probe"]
  securityContext:
    capabilities:
      add: ["SYS_ADMIN"]
  wakeupProbe:
    httpGet:
      path: /healthz
      port: 80
    timeoutSeconds: 60
${TEMPLATE_RESOURCES}
${TEMPLATE_SANDBOX_CONFIG}
snapshotConfig:
  storageLocation: gs://${BUCKET_NAME}/ate-e2e-guestdevices-nofuse${FIXTURE_SUFFIX}/
