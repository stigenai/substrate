# The k8s half of the guestdevices fixture: two micro-VM pools that differ only
# in spec.guestDevices. The suite deploys it only in the micro-VM lane, because
# the API server refuses guestDevices on a gvisor pool.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-e2e${FIXTURE_SUFFIX}

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: fuse
  namespace: ate-e2e${FIXTURE_SUFFIX}
  labels:
    workload: guestdevices-fuse
spec:
  # One worker for the golden snapshot and one for the actor.
  replicas: 2
  workerImage: ${ATEOM_IMAGE}
${WORKERPOOL_RUNTIME}
  guestDevices: [fuse]

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: nofuse
  namespace: ate-e2e${FIXTURE_SUFFIX}
  labels:
    workload: guestdevices-nofuse
spec:
  replicas: 2
  workerImage: ${ATEOM_IMAGE}
${WORKERPOOL_RUNTIME}
